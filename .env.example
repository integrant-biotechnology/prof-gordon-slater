# prof-gordon-slater — environment template.
#
# The site is a static Vite SPA. Copy this file to .env.local and
# uncomment or adjust any keys you wire up.
#
# Vite exposes VITE_-prefixed vars to the client bundle at build time.
# Use these for public values only. Never commit secrets.

# Primary site origin used for canonical, OG, and JSON-LD URLs.
VITE_SITE_URL=https://profgordonslater.com.au

# Optional — Sentry React SDK (developer-audit PR-F).
# VITE_SENTRY_DSN=

# Optional — Vercel/Plausible analytics keys (developer-audit PR-B).
# VITE_ANALYTICS_ID=

# Optional — populated automatically by Vercel at build time.
# VITE_VERCEL_GIT_COMMIT_SHA=
# VITE_VERCEL_ENV=
