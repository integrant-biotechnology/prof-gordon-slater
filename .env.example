# prof-gordon-slater — environment template.
#
# The site is a static Vite SPA. No env vars are required today.
# Copy this file to .env.local and uncomment any keys you wire up.
#
# Vite exposes VITE_-prefixed vars to the client bundle at build time.
# Use these for *public* values only (analytics keys, Sentry DSN).
# Never commit secrets — .env.local is git-ignored.

# Optional — Sentry React SDK (developer-audit PR-F).
# VITE_SENTRY_DSN=

# Optional — Vercel/Plausible analytics keys (developer-audit PR-B).
# VITE_ANALYTICS_ID=

# Optional — populated automatically by Vercel at build time.
# VITE_VERCEL_GIT_COMMIT_SHA=
# VITE_VERCEL_ENV=
